# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=nba-api-service
KAFKA_TOPIC_UPDATES=nba.game.updates
KAFKA_CONSUMER_GROUP_ID=nba-api-consumer-group

# API Configuration
API_PORT=3000

# Database Configuration (for fallback when Redis cache expires)
DB_HOST=localhost
DB_PORT=5433
DB_USER=nba
DB_PASSWORD=nba
DB_NAME=nba
DB_SSL=false
DB_POOL_SIZE=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Logging Configuration
LOG_LEVEL=info

# CORS Configuration
CORS_ORIGIN=http://localhost:3001
